---
interface Props { size?: number; withText?: boolean }
const { size = 28, withText = true } = Astro.props;
---
<span class="inline-flex items-center gap-2.5">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="9" fill="#1C1917" />
    <path d="M9 10.5 L16 22 L23 10.5" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="23.5" cy="22.5" r="2.4" fill="#F97316" />
  </svg>
  {withText && <span class="text-[17px] font-bold tracking-[-0.03em] text-ink">vibe-show</span>}
</span>
