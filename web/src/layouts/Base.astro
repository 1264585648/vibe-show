---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { t, base, type Lang } from '../i18n/strings';

interface Props { lang: Lang; title?: string; description?: string; path?: string }
const { lang, title, description, path = '' } = Astro.props;
const s = t(lang);
const home = base(lang);
const zhUrl = `/${path}`;
const enUrl = `/en/${path}`;
const switchHref = lang === 'en' ? `${zhUrl}?lang=zh` : `${enUrl}?lang=en`;
const pageTitle = title ?? s.meta.title;
const pageDesc = description ?? s.meta.description;
const canonical = new URL(lang === 'en' ? enUrl : zhUrl, Astro.site).href;
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%231C1917'/%3E%3Cpath d='M9 10.5 L16 22 L23 10.5' fill='none' stroke='%23fff' stroke-width='3.2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='23.5' cy='22.5' r='2.4' fill='%23F97316'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang={s.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhUrl, Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(zhUrl, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#FAFAF9" />
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur-xl">
      <div class="container-x flex h-16 items-center justify-between gap-4">
        <a href={home} aria-label="vibe-show home"><Logo /></a>
        <nav class="hidden items-center gap-7 text-sm font-medium text-ink-2 md:flex">
          <a class="hover:text-ink" href={`${home}#projects`}>{s.nav.projects}</a>
          <a class="hover:text-ink" href={`${home}#how`}>{s.nav.how}</a>
          <a class="hover:text-ink" href={`${home}#pricing`}>{s.nav.pricing}</a>
          <a class="hover:text-ink" href={`${home}#faq`}>{s.nav.faq}</a>
        </nav>
        <div class="flex items-center gap-2">
          <a href={switchHref} title={s.nav.switchTitle} class="rounded-full px-3 py-1.5 text-xs font-semibold text-ink-2 hover:bg-black/5">{s.nav.switchLabel}</a>
          <a href={`${home}submit/`} class="btn-dark !px-4 !py-2">{s.nav.submit}</a>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="mt-24 border-t border-line">
      <div class="container-x grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <Logo />
          <p class="mt-3 max-w-xs text-sm text-ink-3">{s.footer.tagline}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-3">{s.footer.product}</p>
          <ul class="mt-3 space-y-2 text-sm text-ink-2">
            <li><a class="hover:text-ink" href={`${home}#projects`}>{s.footer.links.projects}</a></li>
            <li><a class="hover:text-ink" href={`${home}submit/`}>{s.footer.links.submit}</a></li>
            <li><a class="hover:text-ink" href={`${home}#pricing`}>{s.footer.links.pricing}</a></li>
            <li><a class="hover:text-ink" href={`${home}submit/#status`}>{s.footer.links.status}</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-3">{s.footer.legal}</p>
          <ul class="mt-3 space-y-2 text-sm text-ink-2">
            <li><a class="hover:text-ink" href="/terms">{s.footer.links.terms}</a></li>
            <li><a class="hover:text-ink" href="/privacy">{s.footer.links.privacy}</a></li>
            <li><a class="hover:text-ink" href="/refund">{s.footer.links.refund}</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-3">{s.footer.contact}</p>
          <ul class="mt-3 space-y-2 text-sm text-ink-2">
            <li><a class="hover:text-ink" href="mailto:hi@vibe-show.com">hi@vibe-show.com</a></li>
            <li><a class="hover:text-ink" href="mailto:abuse@vibe-show.com">{s.footer.links.abuse}</a></li>
          </ul>
        </div>
      </div>
      <div class="container-x border-t border-line py-6 text-xs text-ink-3">{s.footer.rights}</div>
    </footer>
  </body>
</html>
