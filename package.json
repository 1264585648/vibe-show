{
  "name": "vibe-show",
  "version": "2.0.0",
  "private": true,
  "description": "vibe-show.com — Free Subdomain Provisioning, Zero-Config Edge Reverse Proxy & Showcase Platform for Vibe Coders",
  "type": "module",
  "scripts": {
    "sync:ui": "node --input-type=module -e \"import fs from 'node:fs';fs.mkdirSync('public',{recursive:true});fs.copyFileSync('index.html','public/index.html');console.log('Synced index.html -> public/index.html');\"",
    "db:init:local": "wrangler d1 execute vibe-show-db --local --file=./migrations/0001_init.sql",
    "db:init:remote": "wrangler d1 execute vibe-show-db --remote --file=./migrations/0001_init.sql",
    "dev": "npm run sync:ui && wrangler dev --port 8787",
    "deploy": "npm run sync:ui && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.155.0"
  }
}
